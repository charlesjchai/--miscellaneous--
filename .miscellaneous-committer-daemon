#!/bin/sh

while true; do
    (
        set -e
        if [ "$(git branch --show-current)" == "upcoming" ]; then
            if [ -n "$(git status --porcelain)" ]; then
                git add --all
                git commit -m "$(date +"%Y-%m_%d-%H:%M:%S")"
                git push -u origin upcoming
            fi
        else
            echo "[LOG] Current branch is not upcoming."
        fi
    ) || {
        echo "[ERR] Error occurred" >&2
    }
    sleep 3600
done
