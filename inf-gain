#!/bin/bash

# Usage:
# /opt/chai_bin/inf_gain input.mp3 output.mp3

if [ $# -ne 2 ]; then
    echo "Usage: $0 input.mp3 output.mp3"
    exit 1
fi

INPUT="$1"
OUTPUT="$2"

TMP_WAV=$(mktemp /tmp/infgain_in_XXXXXX.wav)
TMP_OUT=$(mktemp /tmp/infgain_out_XXXXXX.wav)

# Decode MP3 to WAV
ffmpeg -y -i "$INPUT" -acodec pcm_f32le "$TMP_WAV"

# Convert every sample to either -1 or +1
ffmpeg -y -i "$TMP_WAV" \
-af "aeval='if(lt(val(0),0),-1,1)':c=same" \
-acodec pcm_s16le "$TMP_OUT"

# Encode back to MP3
ffmpeg -y -i "$TMP_OUT" -q:a 0 "$OUTPUT"

rm "$TMP_WAV" "$TMP_OUT"

echo "Done: $OUTPUT"
